MODE="desktop"

# Desktop (Tauri) build: fully offline, no backends. Fonts are bundled
# locally (see scripts/woff2/woff2-vite-plugins.js, `mode === "desktop"`).
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DESKTOP=true

VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
VITE_APP_ENABLE_ESLINT=false
